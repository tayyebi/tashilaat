{
  "name": "tashilaat",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev:css": "npx @tailwindcss/cli -i assets/css/main.css -o static/css/main.css --watch",
    "build": "npx @tailwindcss/cli -i assets/css/main.css -o static/css/main.css --minify && hugo --minify",
    "dev": "npx @tailwindcss/cli -i assets/css/main.css -o static/css/main.css && hugo server --buildDrafts --disableFastRender"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.1.4",
    "tailwindcss": "^4.1.4"
  }
}
